# Python
.venv/
__pycache__/
*.pyc

# === Never commit images, scans, model binaries, or archives (anywhere) ===
*.jpg
*.jpeg
*.png
*.rar
*.safetensors
*.ckpt
*.arrow
*.mlmodel

# Raw scans + intermediate line-image harvest (regenerable from scripts)
raw/
gold_harvest/

# Per-line strips + their derived .gt.txt training labels (regenerable from ensemble.tsv)
gold/**/lines/

# Internal working docs — stay LOCAL (user directive). CLAUDE.md also excluded globally.
HANDOVER.md

# review.html needs the local line-strip images to render — keep local only
gold/**/review.html

# Logs
*.log

# === What IS committed (the text): ===
#   README.md
#   scripts/*.py
#   dataset/manifest.csv, dataset/pages.csv
#   processed/transcriptions/reconciled/*.txt (+ turate_reconciled.txt), mccatmus/, tridis/
#   processed/translations/*.txt (+ turate_italiano.txt)
#   gold/<pid>/ensemble.tsv, correct.tsv, *.alto.xml   (per-line candidates + reconciliation)
#   gold/models/v3_review.tsv, *_trainfiles.txt
