# Python
.venv/
__pycache__/
*.pyc

# === SECRETS — never commit. The Gemini API key lives at ~/.config/gemini.key, OUTSIDE the repo. ===
*.key
**/gemini.key

# === Never commit images, scans, model binaries, or archives (anywhere) ===
*.jpg
*.jpeg
*.png
*.rar
*.safetensors
*.ckpt
*.arrow
*.mlmodel

# Original scans (size + rights) — the pipeline reads them from here
raw/

# Pipeline working area: cropped images, raw model candidates, per-page provenance, and other
# regenerable intermediates. The committed deliverables now live at top level in
# transcriptions/ and translations/.
processed/

# Scratch / debugging dumps (underscore-prefixed throwaways); keep the live launcher
pipeline/_*.txt
pipeline/_*.sh
!pipeline/_run_v2.sh
/_*.txt

# Internal working notes — stay LOCAL (CLAUDE.md is excluded globally; HANDOVER is session-local)
HANDOVER.md

# Logs
*.log

# === What IS committed ===
#   transcriptions/<slug>/<pid>.txt     semi-diplomatic transcription per page (the deliverable)
#   transcriptions/_REVIEW_QUEUE.txt    pages/spots flagged for a human paleographer pass
#   translations/<slug>/<pid>.txt       modern-Italian translation per page (the deliverable)
#   registers/<slug>/context.md         per-register glossary injected into every read
#   pipeline/, scripts/, dataset/       the live pipeline + preprocessing + page index
#   README.md, .gitignore
